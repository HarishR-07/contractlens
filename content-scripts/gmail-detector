.cl-analyze-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-left: 8px;
  padding: 4px 10px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 12px;
  font-weight: 600;
  color: #f5f5f2;
  background: #14171f;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  vertical-align: middle;
  transition: background 0.15s ease;
}

.cl-analyze-btn:hover {
  background: #262b3a;
}

.cl-analyze-btn:disabled {
  opacity: 0.6;
  cursor: default;
}

.cl-analyze-btn::before {
  content: "";
  width: 3px;
  height: 12px;
  background: #c4542a;
  border-radius: 1px;
  display: inline-block;
}
